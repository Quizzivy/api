{{define "html"}}<!doctype html>
<html lang="vi">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{template "subject" .}}</title></head>
<body style="margin:0;padding:24px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.5">
<p style="margin:0 0 24px;font-size:18px;font-weight:bold">{{.Org}}</p>
<p>{{if .Params.FullName}}Chào {{.Params.FullName}},{{else}}Chào bạn,{{end}}</p>
<p>Tuần bắt đầu từ {{template "week" .}} ở {{template "classes" .Params.ClassNames}}:</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 16px;border-collapse:collapse">
<tr><td style="padding:2px 16px 2px 0;vertical-align:top">Bài đã nộp</td><td style="padding:2px 0;font-weight:bold">{{.Params.Count}}</td></tr>
<tr><td style="padding:2px 16px 2px 0;vertical-align:top">Bài chờ chấm</td><td style="padding:2px 0;font-weight:bold">{{.Params.ToGrade}}</td></tr>
<tr><td style="padding:2px 16px 2px 0;vertical-align:top">Lượt bị gắn cờ</td><td style="padding:2px 0;font-weight:bold">{{.Params.Flagged}}</td></tr>
</table>
{{with .Params.Attendance}}<p>{{range $i, $a := .}}{{if $i}}<br>{{end}}{{$a.ClassName}}: chuyên cần <b>{{$a.Rate}}%</b> qua {{$a.Sessions}} buổi{{end}}</p>
{{end}}<p>Xem chi tiết trên trang Tổng quan:</p>
<p><a href="{{.Link}}">Mở trang Tổng quan</a></p>
<p style="font-size:14px;word-break:break-all">{{.Link}}</p>
<p style="margin:32px 0 0;font-size:14px"><a href="{{.Settings}}">Chọn loại email bạn muốn nhận</a></p>
</body>
</html>{{end}}
