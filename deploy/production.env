# Production's non-secret settings for the API, the import worker and the
# migration step. The box reads its own copy, Quizzivy/infra vps/app.env, and
# the two must say the same: change both in one go. The secrets are on the box
# only (/opt/quizzivy/app.secrets.env, read after this file).
#
# config/tests/deployment_test.go boots the configuration from this file plus
# placeholder secrets, and scripts/ci/smoke-production-image.sh runs the
# production image with it. One KEY=value per line; a value may be quoted.
APP_ENV=production
API_PORT=8080

# Caddy on this host is the only client of the API's port, and it sets
# X-Real-IP on every request: from the socket when clients reach the box
# directly, from CF-Connecting-IP when only Cloudflare can (vps/caddy). A value
# a client sends under that name is replaced. Never X-Forwarded-For (§6.5).
CLIENT_IP_HEADER=X-Real-IP

# The web is one build on two hosts, each with its own sign-in session
# (Quizzivy/web#51): students at the first, teachers and admins at the second.
# The API reads a request's Origin against these two, points each email link
# into its recipient's host, and refuses to start in production when either is
# missing or is not in CORS_ALLOWED_ORIGINS. A release before v0.13.5 does not
# start with this file: it needs APP_URL, which went with app.quizzivy.com.
STUDENT_APP_URL=https://my.quizzivy.com
STAFF_APP_URL=https://portal.quizzivy.com

CORS_ALLOWED_ORIGINS=https://my.quizzivy.com,https://portal.quizzivy.com

# The landing site, quizzivy.com, is a Pages project of its own
# (quizzivy-landing) and nobody signs in on it. The API admits this origin,
# without credentials, to the two open operations the site calls: sending a
# consultation request and reading the status. It must not be in
# CORS_ALLOWED_ORIGINS; the API refuses to start if it is. A list separated
# by commas: to try the form on the Pages host before the domain is attached,
# put the whole list, with https://quizzivy-landing.pages.dev added, in
# app.secrets.env (the per-host overrides), recreate the API, and take the
# line out again afterwards. A release before v0.13.9 does not read this.
LANDING_URL=https://quizzivy.com

GOOGLE_CLIENT_ID=825841392899-8aaqpsf9nt94usmovva6pifsqopk3dab.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=https://my.quizzivy.com/auth/google/callback,https://portal.quizzivy.com/auth/google/callback

# Argon2id holds 64 MiB per hash; the API container has 768 MB (R-13).
MAX_CONCURRENT_PASSWORD_HASHES=4

IMPORT_S3_BUCKET=quizzivy-imports
IMPORT_WORK_DIR=/home/nonroot/imports
IMPORT_PROCESSING_ENABLED=true
IMPORT_WORKER_WAKE_URL=http://worker:8091/wake
IMPORT_WORKER_WAKE_ADDR=0.0.0.0:8091
IMPORT_WORKER_IDLE_POLL=6h

# Outgoing mail. RESEND_API_KEY and SECRETS_KEY are in app.secrets.env; in
# production the app refuses to start without the whole group.
EMAIL_FROM="Quizzivy <no-reply@quizzivy.com>"
EMAIL_SEND_RATE=2
APP_TIMEZONE=Asia/Ho_Chi_Minh
